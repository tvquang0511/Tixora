{
  "name": "ticketbox-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "verify:push": "node scripts/verify-push.js",
    "verify:push:all": "node scripts/verify-push.js --all",
    "verify:push:fe": "node scripts/verify-push.js --fe-only",
    "verify:push:admin": "node scripts/verify-push.js --admin-only",
    "verify:push:be": "node scripts/verify-push.js --be-only",
    "verify:push:mobile": "node scripts/verify-push.js --mobile-only",
    "build": "pnpm --filter backend-api run build && pnpm --filter web-app run build && pnpm --filter admin-app run build",
    "build:api": "pnpm --filter backend-api run build",
    "build:web": "pnpm --filter web-app run build",
    "build:admin": "pnpm --filter admin-app run build",
    "start:api": "pnpm --filter backend-api run start",
    "start:api:dev": "pnpm --filter backend-api run start:dev",
    "start:api:prod": "pnpm --filter backend-api run start:prod",
    "start:web": "pnpm --filter web-app run dev",
    "start:web:prod": "pnpm --filter web-app run start",
    "start:admin": "pnpm --filter admin-app run dev",
    "start:admin:prod": "pnpm --filter admin-app run start",
    "start:mobile": "pnpm --filter mobile-app run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:api": "pnpm --filter backend-api run typecheck",
    "test:api:unit": "pnpm --filter backend-api run test:unit",
    "test:e2e": "npx -y @playwright/test test",
    "test:e2e:ui": "npx -y @playwright/test test --ui",
    "test:e2e:headed": "npx -y @playwright/test test --headed",
    "test:e2e:report": "npx -y @playwright/test show-report",
    "prisma:generate": "pnpm --filter backend-api run prisma:generate",
    "prisma:validate": "pnpm --filter backend-api run prisma:validate",
    "db:migrate:deploy": "pnpm --filter backend-api run db:migrate:deploy",
    "db:seed": "pnpm --filter backend-api run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3"
  }
}
