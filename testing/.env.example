# ==============================================================================
# 🌐 CẤU HÌNH MÔI TRƯỜNG KIỂM THỬ PLAYWRIGHT E2E TIXORA
# ==============================================================================
# Hướng dẫn: 
# - Nếu test LOCAL: Đổi WEB_URL=http://localhost:3001 và ADMIN_URL=http://localhost:3002
# - Nếu test CLOUD: Giữ nguyên các URL Cloud bên dưới.
# ==============================================================================

# 1. ĐỊA CHỈ TRUY CẬP (TARGET ENVIRONMENT)
WEB_URL="https://tixora.tvquang.id.vn"
ADMIN_URL="https://tixora-admin.tvquang.id.vn"

# Để test Localhost, bỏ comment 2 dòng dưới:
# WEB_URL="http://localhost:3001"
# ADMIN_URL="http://localhost:3002"

# ------------------------------------------------------------------------------
# 2. TÀI KHOẢN KIỂM THỬ (TEST CREDENTIALS)
# Điền tài khoản đã được cấp hoặc đã tồn tại trên Database của môi trường tương ứng:
# ------------------------------------------------------------------------------

# Tài khoản Quản trị viên (Admin / SuperAdmin)
TEST_ADMIN_EMAIL="superadmin@tixora.local"
TEST_ADMIN_PASSWORD="Password123@"

# Tài khoản Ban tổ chức (Organizer)
TEST_ORGANIZER_EMAIL="tuan.organizer@tixora.local"
TEST_ORGANIZER_PASSWORD="Password123@"

# Tài khoản Khán giả mua vé (Audience)
TEST_AUDIENCE_EMAIL="audience1@tixora.local"
TEST_AUDIENCE_PASSWORD="Password123@"

# Tài khoản Nhân viên soát vé (Checker)
TEST_CHECKER_EMAIL="quang.checker@tixora.local"
TEST_CHECKER_PASSWORD="Password123@"
